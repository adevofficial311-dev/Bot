rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // AFK Users collection for bot persistence
    match /afk_users/{userId} {
      allow read, write: if true;
    }

    // Deleted messages for snipe command
    match /deleted_messages/{messageId} {
      allow read, write: if true;
    }

    // AI Configuration
    match /ai_config/{guildId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
